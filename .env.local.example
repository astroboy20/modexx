# ── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → your project → Settings → API

# Public URL — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to expose, protected by RLS policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SERVER ONLY, never expose to browser
# Used in API routes to bypass RLS for trusted writes (sign-up, score submission)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
